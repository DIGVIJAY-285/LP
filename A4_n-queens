
#include <iostream>
using namespace std;

int board[20][20];

// Check whether placing queen is safe
bool isSafe(int row, int col, int n) {

    // Check same column
    for (int i = 0; i < row; i++) {
        if (board[i][col] == 1)
            return false;
    }

    // Check upper left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0; i--, j--) {

        if (board[i][j] == 1)
            return false;
    }

    // Check upper right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < n; i--, j++) {

        if (board[i][j] == 1)
            return false;
    }

    return true;
}

// Function to solve N-Queens
bool solveNQueens(int row, int n) {

    // All queens placed
    if (row == n)
        return true;

    // Try every column
    for (int col = 0; col < n; col++) {

        if (isSafe(row, col, n)) {

            board[row][col] = 1;

            if (solveNQueens(row + 1, n))
                return true;

            // Backtracking
            board[row][col] = 0;
        }
    }

    return false;
}

int main() {
    int n;

    cout << "Enter value of N: ";
    cin >> n;

    if (n < 1 || n > 20) {
        cout << "Invalid N!";
        return 0;
    }

    // Initialize board with zeros
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            board[i][j] = 0;
        }
    }

    // Place first queen at (0,0)
    board[0][0] = 1;

    if (solveNQueens(1, n)) {

        cout << "\nSolution:\n";

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                cout << board[i][j] << " ";
            }
            cout << endl;
        }
    }
    else {
        cout << "No solution exists!";
    }

    return 0;
}

//Complexity	Value
//Time	O(N!) upper bound
//Space	O(N²) for the board
